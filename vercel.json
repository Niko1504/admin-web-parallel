{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.washio.app/api/:path*" },
    { "source": "/media/:path*", "destination": "https://api.washio.app/media/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
